rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para a coleção de Usuários
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.cargoId == "admin";
    }

    // Regras para Clientes
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null;
    }

    // Organizações e Pessoas criadas pelo Funil (campos de busca do "Novo Negócio")
    match /organizacoes/{organizacaoId} {
      allow read, write: if request.auth != null;
    }
    match /pessoas/{pessoaId} {
      allow read, write: if request.auth != null;
    }

    // Regras para Deals e suas subcoleções
    // Leads (contatos que ainda não viraram negócio)
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    match /deals/{dealId} {
      allow read, write: if request.auth != null;

      match /anotacoes/{anotacaoId} {
        allow read, write: if request.auth != null;
      }
      match /atividades/{atividadeId} {
        allow read, write: if request.auth != null;
      }
      match /documentos/{documentoId} {
        allow read, write: if request.auth != null;
      }
    }

    // Notificações (menções com @ nas anotações)
    match /notificacoes/{notificacaoId} {
      allow read, write: if request.auth != null;
    }

    // Funis / etapas (acesso na rota /funil)
    match /funis/{funilId} {
      allow read, write: if request.auth != null;

      match /etapas/{etapaId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
