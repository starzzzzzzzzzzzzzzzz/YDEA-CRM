rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Qualquer pessoa logada pode ler a lista de usuários (é o que popula a tela "Equipe").
    // Escrita (criar/editar/apagar) só é feita por quem já é admin — na prática,
    // a criação de conta acontece pelo painel de Admin, que usa o Firebase Admin
    // SDK no servidor e por isso não passa por essas regras; elas protegem
    // ações feitas direto pelo app do navegador, como trocar o cargo de alguém.
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.cargoId == "admin";
    }

    // Clientes são dado de trabalho do dia a dia — qualquer pessoa logada
    // (já filtrada pelo RBAC dentro do próprio app) pode ler e escrever.
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null;
    }
  }
}
