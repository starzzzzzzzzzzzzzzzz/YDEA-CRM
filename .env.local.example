# Copie este arquivo para .env.local e preencha com os valores do seu projeto Firebase.
# Firebase Console → Configurações do projeto → Geral → "Seus apps" → app Web → Config do SDK.
# .env.local já está no .gitignore — nunca comitar essas chaves.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# E-mail de aviso de novo card (opcional) — serviço Resend (https://resend.com).
# Sem RESEND_API_KEY o CRM funciona normalmente, só não manda e-mail (o aviso no sino continua).
RESEND_API_KEY=
# Remetente. Precisa ser de um domínio verificado no Resend. Ex.: CRM YDEA <crm@seudominio.com.br>
EMAIL_FROM=
