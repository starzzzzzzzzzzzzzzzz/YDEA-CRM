rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Documentos e fotos anexados a um negócio — qualquer pessoa logada
    // pode ler e enviar arquivos (mesmo critério das outras coleções do CRM).
    match /deals/{dealId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Foto de perfil do usuário — qualquer pessoa logada pode ver (aparece
    // nos negócios/atividades da equipe), mas só o dono da conta pode enviar
    // ou trocar a própria foto.
    match /usuarios/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
