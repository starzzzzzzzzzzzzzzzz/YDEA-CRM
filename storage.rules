rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Documentos e fotos anexados a um negócio — qualquer pessoa logada
    // pode ler e enviar arquivos (mesmo critério das outras coleções do CRM).
    match /deals/{dealId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
